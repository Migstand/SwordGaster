<?xml version="1.0" encoding="UTF-8"?>

<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:coord="http://coordenadas.jogo2d.com/soap"
    targetNamespace="http://coordenadas.jogo2d.com/soap"
    elementFormDefault="qualified">
    
    <xs:simpleType name = "DirecaoMovimento">
        <xs:restriction base="xs:string">
            <xs:enumeration value = "DIREITA"/>
            <xs:enumeration value = "ESQUERDA"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name = "CalcularMovimentoRequest">
        <xs:sequence>
            <xs:element name = "posicaoAtualX" type="xs:double"/>
            <xs:element name = "direcao" type="coord:DirecaoMovimento"/>
            <xs:element name = "velocidade" type="xs:double"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name = "CalcularMovimentoResponse">
        <xs:sequence>
            <xs:element name = "posicaoFinalX" type="xs:double"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name = "CalcularPuloRequest">
        <xs:sequence>
            <xs:element name = "posicaoAtualY" type="xs:double"/>
            <xs:element name = "gravidade" type="xs:double"/>
            <xs:element name = "velocidade" type="xs:double"/>
            <xs:element name = "deltatempo" type="xs:double"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name = "CalcularPuloResponse">
        <xs:sequence>
            <xs:element name = "posicaoFinalY" type="xs:double"/>
            <xs:element name = "velocidadeNova" type="xs:double"/>
        </xs:sequence>
    </xs:complexType>

    <xs:element
        name = "CalcularMovimento"
        type = "coord:CalcularMovimentoRequest"/>
    
    <xs:element
        name = "CalcularMovimentoResponse"
        type = "coord:CalcularMovimentoResponse"/>
    
    <xs:element
        name = "CalcularPulo"
        type = "coord:CalcularPuloRequest"/>
    
    <xs:element
        name = "CalcularPuloResponse"
        type = "coord:CalcularPuloResponse"/>
</xs:schema>

